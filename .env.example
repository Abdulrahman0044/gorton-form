# Supabase Dashboard -> Connect -> choose your connection method.
# For Next.js on serverless hosting, use the Transaction pooler URI (port 6543).
# For an always-on Node server, use Session pooler (port 5432) if IPv4-only.
# Keep these credentials SERVER-SIDE; never use NEXT_PUBLIC_ for database secrets.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DB_POOL_SIZE=1

# Supabase Project Settings -> API / Connect.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# SECRET key (sb_secret_...), never expose it to client-side code or commit it.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_REAL_SECRET

# Exact HTTPS public origin, no trailing slash. Local testing uses localhost.
APP_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_ADMIN_PASSWORD
SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Production file scanning is REQUIRED by server code and fails closed if absent.
# Deploy a private ClamAV/clamd service reachable from the Next.js backend.
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false
# Only behind a reverse proxy that OVERWRITES x-real-ip and blocks direct access.
TRUST_PROXY_IP_HEADER=false
